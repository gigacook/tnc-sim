{
  "name": "tnc426-simulator-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Build + QA tooling for the single-file simulator (build.py), the Tauri 2 shell (desktop/) and the browser regression suite (tests/ui/). Not shipped.",
  "license": "MIT",
  "scripts": {
    "build:sim": "python3 build.py",
    "test:manual": "node tests/manual.js",
    "test:ui": "node tests/ui/run.mjs",
    "tauri": "tauri",
    "lint:autosave": "node scripts/autosave-lint.mjs index.html docs/index.html sim",
    "test:autosave": "node tests/ui/autosave.mjs",
    "dev:business": "npm --prefix web run dev:business",
    "dev:play": "npm --prefix web run dev:play",
    "build:business": "npm --prefix web run build:business",
    "build:play": "npm --prefix web run build:play",
    "test:play": "node --test tests/play/",
    "test:e2e": "node tests/e2e/business-isolation.mjs && node tests/e2e/core.mjs && node tests/e2e/play.mjs",
    "desktop:business": "tauri build --config desktop/src-tauri/tauri.business.conf.json",
    "desktop:play": "tauri build --config desktop/src-tauri/tauri.play.conf.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@tauri-apps/cli": "2.12.1",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "three": "0.186.1",
    "three.quarks": "0.17.1"
  }
}
