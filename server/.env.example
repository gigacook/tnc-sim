# Copy to server/.env (gitignored) for `cargo run`. Every value is optional; these are the defaults.
# Never commit a real key. OpenRouter only - never another AI provider.

# Loopback by default; put a reverse proxy (TLS) in front for a public server.
TNC_BIND=127.0.0.1:8426
# The SQLite database (tnc.db) is created and migrated here on first start.
TNC_DATA_DIR=data
# Built web app: cd web && npm ci && npm run build
TNC_WEB_DIR=../web/dist
# Built simulator: python3 build.py (repo root)
TNC_SIM_FILE=../index.html

# TNC_PUBLIC_URL=https://tnc.example.com
# The first account (admin) can always be created; more only with this:
# TNC_ALLOW_SIGNUP=false
# Answer only these Host headers (anti DNS-rebinding), and send a CSP:
# TNC_ALLOWED_HOSTS=127.0.0.1:8426,localhost:8426
# TNC_CSP=default-src 'self'

# AI proxy. Without a key it is off and the simulator uses the operator's own key (BYOK).
# OPENROUTER_API_KEY=
# TNC_AI_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
# Per request; reasoning tokens count against it.
# TNC_AI_MAX_TOKENS=0  (0 = no cap)
# TNC_AI_MONTHLY_BUDGET_USD=5
